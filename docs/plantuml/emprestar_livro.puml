@startuml
skinparam Monochrome true

actor AtorEstudante
participant TratadorDeEmprestimo
participant Movimentacao
participant Livro
participant Emprestimo

AtorEstudante -> TratadorDeEmprestimo : realizarEmprestimo(id_livro, id_estudante)
activate TratadorDeEmprestimo
TratadorDeEmprestimo -> Movimentacao : checarReserva(matricula, id_livro)
activate Movimentacao
Movimentacao --> TratadorDeEmprestimo : Reserva
deactivate Movimentacao

create Emprestimo
TratadorDeEmprestimo --> Emprestimo : <<create>> Emprestimo()
TratadorDeEmprestimo -> Livro : setEstado(estado)
activate Livro
Livro --> TratadorDeEmprestimo : void
deactivate Livro

TratadorDeEmprestimo -> Movimentacao : removerTransacao(t)
activate Movimentacao
Movimentacao --> TratadorDeEmprestimo : void
deactivate Movimentacao

TratadorDeEmprestimo -> Movimentacao : registrarTransacao(t)
activate Movimentacao
Movimentacao --> TratadorDeEmprestimo : void
deactivate Movimentacao

TratadorDeEmprestimo --> AtorEstudante : boolean
deactivate TratadorDeEmprestimo
@enduml